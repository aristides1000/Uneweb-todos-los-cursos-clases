# Dependencias y compilación
node_modules/
dist/
build/
*.tsbuildinfo

# Variables de entorno y secretos
.env
.env.*
!.env.example
*.pem
*.key

# Registros (logs) y archivos temporales
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.tmp/
temp/

# Sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Datos generados o pesados de documentación
# Mantén los .md generados ignorados si se regeneran desde PDF, o quítalo si quieres versionarlos
data/processed-md/*
!data/processed-md/.gitkeep
# Descomenta la siguiente línea si tus PDFs en data/raw-pdfs/ son muy pesados y no quieres subirlos a Git
# data/raw-pdfs/*.pdf
