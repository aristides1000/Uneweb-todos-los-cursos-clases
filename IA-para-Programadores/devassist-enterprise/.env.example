# Clave de API de Google Gemini (no la compartas ni la subas a Git)
GEMINI_API_KEY=aqui_va_tu_api_key

# Modelo de Gemini que usaremos
GEMINI_MODEL=gemini-2.5-flash

# Conexión a PostgreSQL:
# postgresql://usuario:contraseña@host:puerto/nombre_base_datos
DATABASE_URL=postgresql://postgres:tu_contraseña@localhost:5432/devassist_db
