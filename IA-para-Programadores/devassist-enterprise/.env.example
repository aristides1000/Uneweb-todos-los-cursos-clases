# Entorno y servidor
NODE_ENV=development
PORT=3000

# PostgreSQL (conexión principal del sistema)
DATABASE_URL=postgresql://devassist_admin:cambiar_password@localhost:5432/devassist_db

# PostgreSQL (rol restrictivo de solo lectura para consultas del asistente)
READONLY_DATABASE_URL=postgresql://devassist_readonly:cambiar_password_ro@localhost:5432/devassist_db

# Rutas de documentación
RAW_PDFS_DIR=./data/raw-pdfs
PROCESSED_MD_DIR=./data/processed-md
EXTRA_DOCS_DIR=./data/extra-docs

# API de Google Gemini
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=text-embedding-004